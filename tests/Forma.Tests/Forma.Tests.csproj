<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Forma.WebView2, which the renderer tests reference. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forma.Core\Forma.Core.csproj" />
    <ProjectReference Include="..\..\src\Forma.WebView2\Forma.WebView2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Builder's WinForms-free layers are compiled in whole, so new files are tested automatically. -->
    <Compile Include="..\..\src\Forma.Builder\Services\*.cs" LinkBase="Builder\Services" />
    <Compile Include="..\..\src\Forma.Builder\Models\*.cs" LinkBase="Builder\Models" />
    <Compile Include="..\..\src\Forma.Builder\ViewModels\*.cs" LinkBase="Builder\ViewModels" />
    <EmbeddedResource Include="..\..\src\Forma.Builder\DesignerWeb\runtime-script-properties.json" LogicalName="Forma.RuntimeScriptProperties.json" />
  </ItemGroup>

</Project>
