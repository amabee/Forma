---
import DocsLayout from '../layouts/DocsLayout.astro';
import navigation from '../generated/navigation.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path}/`;
const sourceFiles = [
  { key: 'css', name: 'component.css', source: ':host {\n  background-color: #8b5cf6;\n  color: #ffffff;\n  border-radius: 10px;\n}\n\n:host:hover {\n  background-color: #7c3aed;\n}' },
  { key: 'script', name: 'script.js', source: 'const name = forma.bind("nameInput", "value");\n\nforma.on("Click", () => {\n  forma.set("greetingLabel", "text", `Hey, ${name.value}.`);\n});' },
  { key: 'json', name: 'custom-properties.json', source: '{\n  "clicks": 0,\n  "description": "My custom component"\n}' },
];
const count = navigation.filter(page => page.kind).length;
const paths = [
  { step: '01', title: 'Meet your canvas', description: 'Forms, containers, and the workspace. Start here, finish with a working app.', url: 'guides/builder-first-interaction', tag: 'THE FIRST FIVE MINUTES', icon: '◈' },
  { step: '02', title: 'Find your component', description: 'Every control. Every supported property. The right key, the first time.', url: 'components', tag: `${count} COMPONENTS, NO GUESSWORK`, icon: '▦' },
  { step: '03', title: 'Give it some brains', description: 'Events, reactive bindings, imports, and providers. Your logic, your rules.', url: 'guides/global-scripts', tag: 'MAKE IT DO THE THING', icon: '{ }' },
];
---
<DocsLayout title="Forma documentation" description="The practical guide to Forma Builder: every implemented component, exact properties, JavaScript scripts, shared providers, events, and C# models." home>
  <section class="home-hero">
    <div class="hero-copy">
      <div class="release-pill"><span class="status-dot"></span> THE FORMA FIELD GUIDE <span>↗</span></div>
      <h1>Build it.<br /><span class="gradient-text">Make it yours.</span></h1>
      <p>Your canvas, your components, your code.<br />The docs for turning “what if” into “it works.”</p>
      <div class="hero-actions"><a class="button-primary" href={href('guides/builder-first-interaction')}>Let’s build something <span aria-hidden="true">→</span></a><a class="button-secondary" href={href('components')}>Browse components <span aria-hidden="true">↗</span></a></div>
      <div class="hero-facts"><span><b>{count}</b> component pages</span><span><b>JS + C#</b> examples</span><span><b>Your</b> next good idea</span></div>
    </div>
    <div class="hero-demo" aria-label="Interactive illustration of a simple Forma form">
      <div class="demo-titlebar"><div class="window-dots"><i></i><i></i><i></i></div><span>hello-world.forma</span><span class="demo-badge">Preview</span></div>
      <div class="demo-canvas">
        <div class="demo-greeting-icon" aria-hidden="true">✦</div><span class="demo-eyebrow">A LITTLE INPUT. A LITTLE MAGIC.</span>
        <h2 id="demo-title">Hey, builder.</h2><p>Your first interaction starts right here.</p>
        <form id="greeting-demo"><label for="demo-name">What should we call you?</label><input id="demo-name" name="name" placeholder="Your name, superstar" maxlength="40" /><button type="submit">Say hello <span aria-hidden="true">→</span></button></form>
        <p id="demo-result" role="status" aria-live="polite">Go on. It actually works.</p>
      </div>
      <div class="demo-code"><span class="code-file-dot"></span><span>button.script.js</span><code><span class="token-purple">forma</span>.on(<span class="token-green">"Click"</span>, () =&gt; &#123;<br />&nbsp; <span class="token-purple">const</span> name = forma.get(<span class="token-green">"nameInput"</span>, <span class="token-green">"value"</span>);<br />&nbsp; forma.set(<span class="token-green">"greeting"</span>, <span class="token-green">"text"</span>, <span class="token-green">`Hey, &#36;&#123;name&#125;.`</span>);<br />&#125;);</code></div>
      <span class="demo-floating-label"><span class="status-dot"></span> Idea → interface → interaction</span>
    </div>
  </section>
  <section class="home-paths" aria-labelledby="start-heading">
    <div class="section-label"><h2 id="start-heading">Pick your next move.</h2><span>The blank canvas won’t stay blank for long.</span></div>
    <div class="path-grid">{paths.map(item => <a class="path-card" href={href(item.url)}><div class="path-card-top"><span class="path-icon" aria-hidden="true">{item.icon}</span><span>{item.step}</span></div><div class="card-eyebrow">{item.tag}</div><h3>{item.title} <span aria-hidden="true">↗</span></h3><p>{item.description}</p></a>)}</div>
  </section>
  <section class="home-api" aria-labelledby="api-heading">
    <div><div class="page-eyebrow">SMALL API. PLENTY OF POSSIBILITIES.</div><h2 id="api-heading">The right value.<br />At the right time.</h2><p>Read a snapshot. Bind a live value. Share a provider.<br />No more “why is my name still empty?”</p><a class="text-link" href={href('guides/runtime-properties')}>Get to know forma <span aria-hidden="true">→</span></a></div>
    <div class="api-stack"><a href={href('guides/runtime-properties')}><code>forma.get()</code><span>A value, right now.</span><span>→</span></a><a href={href('guides/component-customization')}><code>forma.bind()</code><span>A live reference. Use .value.</span><span>→</span></a><a href={href('guides/global-scripts')}><code>forma.use()</code><span>Your shared provider, everywhere.</span><span>→</span></a></div>
  </section>
  <section class="home-source"><div><span class="page-eyebrow">FROM CANVAS TO CODE</span><h2>One component. Three sources.</h2><p>Your style, your logic, your custom data. Each gets its own file and editor tab.</p></div><div class="source-window"><div class="source-window-label"><span class="status-dot"></span> greetingButton / Custom Properties</div><div class="source-tabs" role="tablist" aria-label="Example component sources">{sourceFiles.map((file, index) => <button id={`source-tab-${file.key}`} role="tab" data-source-tab={file.key} aria-selected={index === 0} aria-controls={`source-${file.key}`} tabindex={index === 0 ? 0 : -1}>{file.name}</button>)}</div>{sourceFiles.map((file, index) => <pre id={`source-${file.key}`} role="tabpanel" aria-labelledby={`source-tab-${file.key}`} hidden={index !== 0}><code>{file.source}</code></pre>)}<div class="source-window-footer">Scoped styles. Component events. Editable JSON. <a href={href('guides/component-customization')}>Make it yours →</a></div></div></section>
  <section class="home-last"><span aria-hidden="true">✦</span><p>Built for builders who ask<br /><strong>“Can we make it do this?”</strong></p><a class="text-link" href={href('guides/recipes')}>Yes. Start with a recipe. →</a></section>
  <script>
    const sourceTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-source-tab]')];
    function activateSource(tab: HTMLButtonElement) {
      sourceTabs.forEach(button => {
        const active = tab === button;
        button.setAttribute('aria-selected', String(active)); button.tabIndex = active ? 0 : -1;
        document.getElementById(`source-${button.dataset.sourceTab}`)!.hidden = !active;
      });
    }
    sourceTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateSource(tab));
      tab.addEventListener('keydown', event => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? sourceTabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + sourceTabs.length) % sourceTabs.length;
        activateSource(sourceTabs[next]); sourceTabs[next].focus();
      });
    });
    document.getElementById('greeting-demo')?.addEventListener('submit', event => {
      event.preventDefault();
      const name = (document.getElementById('demo-name') as HTMLInputElement).value.trim();
      document.getElementById('demo-title')!.textContent = name ? `Hey, ${name}.` : 'Hey, builder.';
      document.getElementById('demo-result')!.textContent = name ? 'There it is. Your first tiny interaction. ✨' : 'A name would be a lovely place to start.';
    });
  </script>
</DocsLayout>
