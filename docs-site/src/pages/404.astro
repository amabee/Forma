---
import DocsLayout from '../layouts/DocsLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<DocsLayout title="That page wandered off." description="Find your way back to the Forma documentation.">
  <div class="callout"><span>404</span><div><strong>The component is probably still here. The URL isn’t.</strong><p>Search the docs, or head back to the library.</p><a class="text-link" href={`${base}/components/`}>Find your component →</a></div></div>
</DocsLayout>
