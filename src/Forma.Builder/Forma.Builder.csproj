<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Forma.WebView2\Forma.WebView2.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="DesignerWeb\**\*" Exclude="DesignerWeb\code-editor.bundle.js;DesignerWeb\code-editor.bundle.js.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DesignerWeb\code-editor.bundle.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildDesignerAssets" BeforeTargets="BeforeBuild"
          Condition="Exists('Frontend/node_modules/.bin/tailwindcss.cmd')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Frontend" Command="npm.cmd run build" />
  </Target>
</Project>
